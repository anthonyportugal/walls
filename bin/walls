#!/usr/bin/env bash
# walls: minimal tool for the wallpaper collection (list, add, update-readme).
# Installation and links are owned by the public dotfiles CLI:
#   dotfiles add walls
# which clones this repository and links wallpapers/ to
# ~/.local/share/wallpapers and bin/walls to ~/.local/bin/walls.

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
# Resolve the real path so the tool works through ~/.local/bin/walls.
SCRIPT_DIR=$(cd -- "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)
WALLPAPERS_DIR="$REPO_ROOT/wallpapers"

DOTFILES_LANG="${DOTFILES_LANG:-en}"

_t() {
  local en_text=$1
  local es_text=${2:-$1}
  if [[ "${DOTFILES_LANG:-en}" == "es" ]]; then
    printf '%b' "$es_text"
  else
    printf '%b' "$en_text"
  fi
}

setup_colors() {
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && (( $(tput colors 2>/dev/null || echo 0) >= 8 )); then
    C_RESET='\033[0m'
    C_BOLD='\033[1m'
    C_MAUVE='\033[38;2;203;166;247m'
    C_BLUE='\033[38;2;137;180;250m'
    C_RED='\033[38;2;243;139;168m'
  else
    C_RESET='' C_BOLD='' C_MAUVE='' C_BLUE='' C_RED=''
  fi
}
setup_colors

info() {
  printf '%b%b[%s]%b %b==>%b %s\n' "$C_MAUVE" "$C_BOLD" "$PROGRAM_NAME" "$C_RESET" "$C_BLUE" "$C_RESET" "$*"
}

error() {
  local label
  label=$(_t "error:" "error:")
  printf '%b%b[%s]%b %b%b%s%b %s\n' "$C_MAUVE" "$C_BOLD" "$PROGRAM_NAME" "$C_RESET" "$C_RED" "$C_BOLD" "$label" "$C_RESET" "$*" >&2
}

die() {
  error "$*"
  exit 1
}

usage() {
  if [[ "${DOTFILES_LANG:-en}" == "es" ]]; then
    cat <<HELP
Uso:
  $PROGRAM_NAME list
  $PROGRAM_NAME add <imagen.png|jpg> [--name w-XXX] [--quality 95]
  $PROGRAM_NAME update-readme
  $PROGRAM_NAME help

Comandos:
  list           Lista los wallpapers disponibles con su resolución y peso.
  add            Convierte y añade una nueva imagen en formato WebP a wallpapers/.
  update-readme  Actualiza automáticamente la galería de wallpapers en README.md.

Opciones:
  --lang en|es   Idioma de la ayuda (default: en).
  -h, --help     Muestra esta ayuda.

La instalación y los enlaces los gestiona el CLI de dotfiles:
  dotfiles add walls
HELP
  else
    cat <<HELP
Usage:
  $PROGRAM_NAME list
  $PROGRAM_NAME add <image.png|jpg> [--name w-XXX] [--quality 95]
  $PROGRAM_NAME update-readme
  $PROGRAM_NAME help

Commands:
  list           Lists available wallpapers with resolution and file size.
  add            Converts and adds a new image in WebP format to wallpapers/.
  update-readme  Automatically updates wallpaper gallery preview in README.md.

Options:
  --lang en|es   Help language (default: en).
  -h, --help     Show this help.

Installation and links are managed by the dotfiles CLI:
  dotfiles add walls
HELP
  fi
}

find_converter() {
  if command -v magick >/dev/null 2>&1; then
    printf "magick\n"
  elif command -v cwebp >/dev/null 2>&1; then
    printf "cwebp\n"
  elif command -v convert >/dev/null 2>&1; then
    printf "convert\n"
  else
    printf "none\n"
  fi
}

# shellcheck disable=SC2012
cmd_list() {
  local count=0
  printf "%-14s %-12s %-10s %s\n" "ARCHIVO" "RESOLUCIÓN" "PESO" "RUTA"
  printf "%s\n" "---------------------------------------------------------"

  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    local name="${file##*/}"
    local size
    size=$(ls -lh "$file" | awk '{print $5}')
    local res="desconocida"

    if command -v identify >/dev/null 2>&1; then
      res=$(identify -format "%wx%h" "$file" 2>/dev/null || printf "desconocida")
    fi

    printf "%-14s %-12s %-10s %s\n" "$name" "$res" "$size" "$file"
    (( count++ )) || true
  done < <(find "$WALLPAPERS_DIR" -maxdepth 2 -type f -name "*.webp" 2>/dev/null | sort)

  printf "\nTotal: %d wallpaper(s) en WebP.\n" "$count"
}

# shellcheck disable=SC2012
cmd_add() {
  local input_file=${1:-}
  [[ -n "$input_file" ]] || die "Debe especificar la ruta a la imagen que desea agregar."
  [[ -r "$input_file" ]] || die "No se puede leer el archivo de origen: $input_file"

  shift || true
  local custom_name=""
  local quality=95

  while (( $# > 0 )); do
    case "$1" in
      --name)
        custom_name=$2
        shift 2
        ;;
      --quality)
        quality=$2
        shift 2
        ;;
      *)
        die "Opción desconocida para add: $1"
        ;;
    esac
  done

  local tool
  tool=$(find_converter)
  [[ "$tool" != "none" ]] || die "Se requiere ImageMagick (magick/convert) o cwebp para optimizar la imagen a WebP."

  mkdir -p -- "$WALLPAPERS_DIR"

  local target_name=""
  if [[ -n "$custom_name" ]]; then
    target_name="${custom_name%.*}.webp"
  else
    local max_num=0
    local existing
    for existing in "$WALLPAPERS_DIR"/w-*.webp; do
      if [[ -f "$existing" ]]; then
        local base_num
        base_num=$(basename "$existing" .webp)
        base_num=${base_num#w-}
        if [[ "$base_num" =~ ^[0-9]+$ ]]; then
          local val=$((10#$base_num))
          if (( val > max_num )); then
            max_num=$val
          fi
        fi
      fi
    done
    local next_num=$(( max_num + 1 ))
    printf -v target_name "w-%03d.webp" "$next_num"
  fi

  local destination="$WALLPAPERS_DIR/$target_name"
  local orig_size
  orig_size=$(stat -c%s "$input_file")

  info "Convirtiendo $input_file -> $target_name (calidad: ${quality}% con $tool)..."
  case "$tool" in
    magick)
      magick "$input_file" -quality "$quality" "$destination"
      ;;
    convert)
      convert "$input_file" -quality "$quality" "$destination"
      ;;
    cwebp)
      cwebp -q "$quality" "$input_file" -o "$destination" >/dev/null 2>&1
      ;;
  esac

  local new_size
  new_size=$(stat -c%s "$destination")
  local savings=$(( (orig_size - new_size) * 100 / orig_size ))

  info "✓ Creado: $target_name ($(ls -lh "$destination" | awk '{print $5}'), ahorro: -${savings}%)"
  info "El archivo original NO se copia al repositorio para evitar duplicaciones."

  cmd_update_readme
}

# shellcheck disable=SC2016
generate_gallery_markdown() {
  local files=()
  while IFS= read -r f; do
    [[ -f "$f" ]] && files+=("$f")
  done < <(find "$WALLPAPERS_DIR" -maxdepth 2 -type f -name "*.webp" 2>/dev/null | sort)

  local total=${#files[@]}
  if (( total == 0 )); then
    return 0
  fi

  printf '<details open>\n'
  printf '<summary><b>🖼️ Wallpaper Collection (%d available)</b> <i>— Click to collapse / expand</i></summary>\n' "$total"
  printf '<br>\n\n'

  local i=0
  while (( i < total )); do
    local f1="${files[i]}"
    local name1="${f1##*/}"
    local base1="${name1%.webp}"
    local res1=""
    if command -v identify >/dev/null 2>&1; then
      res1=$(identify -format "%wx%h" "$f1" 2>/dev/null || true)
    fi
    local tag1=""
    case "$res1" in
      1920x1080) tag1=" (1080p)" ;;
      2184x1224) tag1=" (2K)" ;;
      2560x1440) tag1=" (2K QHD)" ;;
      3840x2160) tag1=" (4K UHD)" ;;
      "") tag1="" ;;
      *) tag1=" ($res1)" ;;
    esac

    local j=$(( i + 1 ))
    if (( j < total )); then
      local f2="${files[j]}"
      local name2="${f2##*/}"
      local base2="${name2%.webp}"
      local res2=""
      if command -v identify >/dev/null 2>&1; then
        res2=$(identify -format "%wx%h" "$f2" 2>/dev/null || true)
      fi
      local tag2=""
      case "$res2" in
        1920x1080) tag2=" (1080p)" ;;
        2184x1224) tag2=" (2K)" ;;
        2560x1440) tag2=" (2K QHD)" ;;
        3840x2160) tag2=" (4K UHD)" ;;
        "") tag2="" ;;
        *) tag2=" ($res2)" ;;
      esac

      printf '| `%s`%s | `%s`%s |\n' "$base1" "$tag1" "$base2" "$tag2"
      if (( i == 0 )); then
        printf '| :---: | :---: |\n'
      fi
      printf '| <img src="wallpapers/%s" width="380" alt="%s"> | <img src="wallpapers/%s" width="380" alt="%s"> |\n' "$name1" "$base1" "$name2" "$base2"
    else
      printf '| `%s`%s | |\n' "$base1" "$tag1"
      if (( i == 0 )); then
        printf '| :---: | :---: |\n'
      fi
      printf '| <img src="wallpapers/%s" width="380" alt="%s"> | |\n' "$name1" "$base1"
    fi

    (( i += 2 ))
  done

  printf '\n</details>\n\n'
}

cmd_update_readme() {
  local readme="$REPO_ROOT/README.md"
  [[ -f "$readme" ]] || return 0

  local gallery_file tmp_file
  gallery_file=$(mktemp)
  tmp_file=$(mktemp)
  generate_gallery_markdown > "$gallery_file"

  [[ -s "$gallery_file" ]] || {
    rm -f "$gallery_file" "$tmp_file"
    return 0
  }

  awk '
    BEGIN { in_gallery = 0 }
    /^## 🎨 Gallery/ {
      print
      print ""
      while ((getline line < gallery_path) > 0) {
        print line
      }
      close(gallery_path)
      in_gallery = 1
      next
    }
    in_gallery && /^---/ {
      in_gallery = 0
      print
      next
    }
    !in_gallery {
      print
    }
  ' gallery_path="$gallery_file" "$readme" > "$tmp_file"

  rm -f "$gallery_file"

  if cmp -s "$readme" "$tmp_file"; then
    rm -f "$tmp_file"
  else
    mv "$tmp_file" "$readme"
    info "✓ README.md actualizado automáticamente con la galería de wallpapers."
  fi
}

main() {
  local -a args_filtered=()
  while (( $# > 0 )); do
    case "$1" in
      --lang)
        [[ -n "${2-}" ]] || die "option --lang requires a value"
        DOTFILES_LANG=$2
        export DOTFILES_LANG
        shift 2
        ;;
      --lang=*)
        DOTFILES_LANG=${1#*=}
        [[ -n "$DOTFILES_LANG" ]] || die "option --lang requires a value"
        export DOTFILES_LANG
        shift
        ;;
      *)
        args_filtered+=("$1")
        shift
        ;;
    esac
  done
  if (( ${#args_filtered[@]} > 0 )); then
    set -- "${args_filtered[@]}"
  else
    set --
  fi

  if (( $# == 0 )); then
    usage
    return 0
  fi

  local action=$1
  shift

  case "$action" in
    list)
      cmd_list
      ;;
    add)
      cmd_add "$@"
      ;;
    update-readme)
      cmd_update_readme
      ;;
    help|-h|--help)
      usage
      ;;
    setup|sync|update|link|unlink|doctor)
      die "$(_t \
        "'$PROGRAM_NAME $action' was removed: install and manage walls with the dotfiles CLI (dotfiles add walls)." \
        "'$PROGRAM_NAME $action' fue retirado: instala y gestiona walls con el CLI de dotfiles (dotfiles add walls).")"
      ;;
    *)
      die "$(_t "Unknown command: $action. Use $PROGRAM_NAME help." "Comando desconocido: $action. Use $PROGRAM_NAME help.")"
      ;;
  esac
}

main "$@"
