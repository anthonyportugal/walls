#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_DIR=$(cd -- "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)
WALLPAPERS_DIR="$REPO_ROOT/wallpapers"

TARGET_DIR=${HOME:-}

info() {
  printf "==> %s\n" "$*"
}

warn() {
  printf "aviso: %s\n" "$*" >&2
}

error() {
  printf "error: %s\n" "$*" >&2
}

die() {
  error "$*"
  exit 1
}

usage() {
  cat <<HELP
Uso:
  $PROGRAM_NAME link [--target DIR]
  $PROGRAM_NAME unlink [--target DIR]
  $PROGRAM_NAME add <imagen.png|jpg> [--name w-XXX] [--quality 95]
  $PROGRAM_NAME doctor [--target DIR]
  $PROGRAM_NAME list
  $PROGRAM_NAME update-readme
  $PROGRAM_NAME help

Comandos:
  link           Enlaza la colección a ~/.local/share/wallpapers y el ejecutable a ~/.local/bin/walls.
  unlink         Retira los enlaces de ~/.local/share/wallpapers y ~/.local/bin/walls.
  add            Convierte y añade una nueva imagen en formato WebP a wallpapers/.
  doctor         Comprueba el estado del repositorio, los enlaces y los convertidores.
  list           Lista los wallpapers disponibles con su resolución y peso.
  update-readme  Actualiza automáticamente la galería de wallpapers en README.md.
HELP
}

find_converter() {
  if command -v magick >/dev/null 2>&1; then
    printf "magick\n"
  elif command -v cwebp >/dev/null 2>&1; then
    printf "cwebp\n"
  elif command -v convert >/dev/null 2>&1; then
    printf "convert\n"
  else
    printf "none\n"
  fi
}

cmd_link() {
  local target_home=${TARGET_DIR:-$HOME}
  local target_data="${XDG_DATA_HOME:-$target_home/.local/share}/wallpapers"
  local target_bin="$target_home/.local/bin"

  mkdir -p -- "${target_data%/*}" "$target_bin" "$WALLPAPERS_DIR"

  # 1. Enlace de la colección de wallpapers
  if [[ -L "$target_data" ]]; then
    local current_link
    current_link=$(readlink -f -- "$target_data" || true)
    if [[ "$current_link" == "$WALLPAPERS_DIR" ]]; then
      info "Wallpapers ya está enlazado correctamente: $target_data -> $WALLPAPERS_DIR"
    else
      warn "Actualizando enlace existente de $current_link a $WALLPAPERS_DIR"
      ln -sfn -- "$WALLPAPERS_DIR" "$target_data"
    fi
  elif [[ -d "$target_data" ]]; then
    die "$target_data ya existe y es un directorio real (no un enlace). Mueva o respalde su contenido primero."
  else
    ln -sfn -- "$WALLPAPERS_DIR" "$target_data"
    info "Enlace de wallpapers creado: $target_data -> $WALLPAPERS_DIR"
  fi

  # 2. Enlace del comando 'walls' en ~/.local/bin
  local bin_link="$target_bin/walls"
  if [[ -L "$bin_link" ]]; then
    local current_bin
    current_bin=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_bin" == "$SCRIPT_DIR/walls" ]]; then
      info "Comando walls ya enlazado en $bin_link"
    else
      ln -sfn -- "$SCRIPT_DIR/walls" "$bin_link"
      info "Comando walls actualizado en $bin_link"
    fi
  elif [[ -e "$bin_link" ]]; then
    warn "$bin_link ya existe y no es un enlace simbólico. No se sobrescribirá."
  else
    ln -sfn -- "$SCRIPT_DIR/walls" "$bin_link"
    info "Comando walls enlazado en $bin_link"
  fi
}

cmd_unlink() {
  local target_home=${TARGET_DIR:-$HOME}
  local target_data="${XDG_DATA_HOME:-$target_home/.local/share}/wallpapers"
  local target_bin="$target_home/.local/bin/walls"

  # 1. Retirar enlace de wallpapers
  if [[ -L "$target_data" ]]; then
    local current_link
    current_link=$(readlink -f -- "$target_data" || true)
    if [[ "$current_link" == "$WALLPAPERS_DIR" ]]; then
      rm -f -- "$target_data"
      info "Enlace de wallpapers retirado: $target_data"
    else
      warn "$target_data enlaza a $current_link (ajeno a este repositorio). Omitiendo."
    fi
  elif [[ -e "$target_data" ]]; then
    warn "$target_data no es un enlace simbólico. No se modificará."
  else
    info "$target_data no existe. Nada que retirar."
  fi

  # 2. Retirar enlace del comando 'walls'
  if [[ -L "$target_bin" ]]; then
    local current_bin
    current_bin=$(readlink -f -- "$target_bin" || true)
    if [[ "$current_bin" == "$SCRIPT_DIR/walls" ]]; then
      rm -f -- "$target_bin"
      info "Enlace del comando walls retirado: $target_bin"
    fi
  fi
}

cmd_list() {
  local count=0
  printf "%-14s %-12s %-10s %s\n" "ARCHIVO" "RESOLUCIÓN" "PESO" "RUTA"
  printf "%s\n" "---------------------------------------------------------"

  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    local name="${file##*/}"
    local size
    size=$(ls -lh "$file" | awk '{print $5}')
    local res="desconocida"

    if command -v identify >/dev/null 2>&1; then
      res=$(identify -format "%wx%h" "$file" 2>/dev/null || printf "desconocida")
    fi

    printf "%-14s %-12s %-10s %s\n" "$name" "$res" "$size" "$file"
    (( count++ )) || true
  done < <(find "$WALLPAPERS_DIR" -maxdepth 2 -type f -name "*.webp" 2>/dev/null | sort)

  printf "\nTotal: %d wallpaper(s) en WebP.\n" "$count"
}

cmd_add() {
  local input_file=${1:-}
  [[ -n "$input_file" ]] || die "Debe especificar la ruta a la imagen que desea agregar."
  [[ -r "$input_file" ]] || die "No se puede leer el archivo de origen: $input_file"

  shift || true
  local custom_name=""
  local quality=95

  while (( $# > 0 )); do
    case "$1" in
      --name)
        custom_name=$2
        shift 2
        ;;
      --quality)
        quality=$2
        shift 2
        ;;
      *)
        die "Opción desconocida para add: $1"
        ;;
    esac
  done

  local tool
  tool=$(find_converter)
  [[ "$tool" != "none" ]] || die "Se requiere ImageMagick (magick/convert) o cwebp para optimizar la imagen a WebP."

  mkdir -p -- "$WALLPAPERS_DIR"

  local target_name=""
  if [[ -n "$custom_name" ]]; then
    target_name="${custom_name%.*}.webp"
  else
    local max_num=0
    local existing
    for existing in "$WALLPAPERS_DIR"/w-*.webp; do
      if [[ -f "$existing" ]]; then
        local base_num
        base_num=$(basename "$existing" .webp)
        base_num=${base_num#w-}
        if [[ "$base_num" =~ ^[0-9]+$ ]]; then
          local val=$((10#$base_num))
          if (( val > max_num )); then
            max_num=$val
          fi
        fi
      fi
    done
    local next_num=$(( max_num + 1 ))
    printf -v target_name "w-%03d.webp" "$next_num"
  fi

  local destination="$WALLPAPERS_DIR/$target_name"
  local orig_size
  orig_size=$(stat -c%s "$input_file")

  info "Convirtiendo $input_file -> $target_name (calidad: ${quality}% con $tool)..."
  case "$tool" in
    magick)
      magick "$input_file" -quality "$quality" "$destination"
      ;;
    convert)
      convert "$input_file" -quality "$quality" "$destination"
      ;;
    cwebp)
      cwebp -q "$quality" "$input_file" -o "$destination" >/dev/null 2>&1
      ;;
  esac

  local new_size
  new_size=$(stat -c%s "$destination")
  local savings=$(( (orig_size - new_size) * 100 / orig_size ))

  info "✓ Creado: $target_name ($(ls -lh "$destination" | awk '{print $5}'), ahorro: -${savings}%)"
  info "El archivo original NO se copia al repositorio para evitar duplicaciones."

  cmd_update_readme
}

generate_gallery_markdown() {
  local files=()
  while IFS= read -r f; do
    [[ -f "$f" ]] && files+=("$f")
  done < <(find "$WALLPAPERS_DIR" -maxdepth 2 -type f -name "*.webp" 2>/dev/null | sort)

  local total=${#files[@]}
  if (( total == 0 )); then
    return 0
  fi

  printf '<details open>\n'
  printf '<summary><b>🖼️ Wallpaper Collection (%d available)</b> <i>— Click to collapse / expand</i></summary>\n' "$total"
  printf '<br>\n\n'

  local i=0
  while (( i < total )); do
    local f1="${files[i]}"
    local name1="${f1##*/}"
    local base1="${name1%.webp}"
    local res1=""
    if command -v identify >/dev/null 2>&1; then
      res1=$(identify -format "%wx%h" "$f1" 2>/dev/null || true)
    fi
    local tag1=""
    case "$res1" in
      1920x1080) tag1=" (1080p)" ;;
      2184x1224) tag1=" (2K)" ;;
      2560x1440) tag1=" (2K QHD)" ;;
      3840x2160) tag1=" (4K UHD)" ;;
      "") tag1="" ;;
      *) tag1=" ($res1)" ;;
    esac

    local j=$(( i + 1 ))
    if (( j < total )); then
      local f2="${files[j]}"
      local name2="${f2##*/}"
      local base2="${name2%.webp}"
      local res2=""
      if command -v identify >/dev/null 2>&1; then
        res2=$(identify -format "%wx%h" "$f2" 2>/dev/null || true)
      fi
      local tag2=""
      case "$res2" in
        1920x1080) tag2=" (1080p)" ;;
        2184x1224) tag2=" (2K)" ;;
        2560x1440) tag2=" (2K QHD)" ;;
        3840x2160) tag2=" (4K UHD)" ;;
        "") tag2="" ;;
        *) tag2=" ($res2)" ;;
      esac

      printf '| `%s`%s | `%s`%s |\n' "$base1" "$tag1" "$base2" "$tag2"
      if (( i == 0 )); then
        printf '| :---: | :---: |\n'
      fi
      printf '| <img src="wallpapers/%s" width="380" alt="%s"> | <img src="wallpapers/%s" width="380" alt="%s"> |\n' "$name1" "$base1" "$name2" "$base2"
    else
      printf '| `%s`%s | |\n' "$base1" "$tag1"
      if (( i == 0 )); then
        printf '| :---: | :---: |\n'
      fi
      printf '| <img src="wallpapers/%s" width="380" alt="%s"> | |\n' "$name1" "$base1"
    fi

    (( i += 2 ))
  done

  printf '\n</details>\n'
}

cmd_update_readme() {
  local readme="$REPO_ROOT/README.md"
  [[ -f "$readme" ]] || return 0

  local gallery_file tmp_file
  gallery_file=$(mktemp)
  tmp_file=$(mktemp)
  generate_gallery_markdown > "$gallery_file"

  [[ -s "$gallery_file" ]] || {
    rm -f "$gallery_file" "$tmp_file"
    return 0
  }

  awk '
    BEGIN { in_gallery = 0 }
    /^## 🎨 Gallery/ {
      print
      print ""
      while ((getline line < gallery_path) > 0) {
        print line
      }
      close(gallery_path)
      in_gallery = 1
      next
    }
    in_gallery && /^---/ {
      in_gallery = 0
      print
      next
    }
    !in_gallery {
      print
    }
  ' gallery_path="$gallery_file" "$readme" > "$tmp_file"

  rm -f "$gallery_file"

  if cmp -s "$readme" "$tmp_file"; then
    rm -f "$tmp_file"
  else
    mv "$tmp_file" "$readme"
    info "✓ README.md actualizado automáticamente con la galería de wallpapers."
  fi
}

cmd_doctor() {
  local target_home=${TARGET_DIR:-$HOME}
  local target_data="${XDG_DATA_HOME:-$target_home/.local/share}/wallpapers"
  local target_bin="$target_home/.local/bin/walls"
  local issues=0

  info "Comprobando repositorio walls..."

  local stray_images
  stray_images=$(find "$WALLPAPERS_DIR" -maxdepth 2 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) ! -path "*/.*" 2>/dev/null || true)
  if [[ -n "$stray_images" ]]; then
    warn "Se encontraron imágenes que no son WebP en wallpapers/:"
    printf "%s\n" "$stray_images" >&2
    (( issues++ )) || true
  else
    info "✓ Solo se almacenan archivos WebP en wallpapers/ (cero duplicación)"
  fi

  if [[ -L "$target_data" ]]; then
    local current_link
    current_link=$(readlink -f -- "$target_data" || true)
    if [[ "$current_link" == "$WALLPAPERS_DIR" ]]; then
      info "✓ Enlace de wallpapers correcto: $target_data -> $WALLPAPERS_DIR"
    else
      warn "$target_data enlaza a $current_link en vez de $WALLPAPERS_DIR"
      (( issues++ )) || true
    fi
  else
    warn "$target_data no está enlazado a este repositorio. Ejecute: $PROGRAM_NAME link"
    (( issues++ )) || true
  fi

  if [[ -L "$target_bin" ]]; then
    local current_bin
    current_bin=$(readlink -f -- "$target_bin" || true)
    if [[ "$current_bin" == "$SCRIPT_DIR/walls" ]]; then
      info "✓ Comando disponible en PATH: $target_bin -> $SCRIPT_DIR/walls"
    else
      warn "$target_bin enlaza a $current_bin en vez de $SCRIPT_DIR/walls"
      (( issues++ )) || true
    fi
  else
    warn "$target_bin no está enlazado en PATH. Ejecute: $PROGRAM_NAME link"
    (( issues++ )) || true
  fi

  local tool
  tool=$(find_converter)
  if [[ "$tool" != "none" ]]; then
    info "✓ Convertidor disponible para nuevos fondos: $tool"
  else
    warn "No se encontró convertidor WebP (instale imagemagick o libwebp)"
    (( issues++ )) || true
  fi

  if (( issues == 0 )); then
    info "Doctor: todo correcto en walls."
    return 0
  else
    warn "Doctor: se encontraron $issues advertencia(s)."
    return 1
  fi
}

main() {
  if (( $# == 0 )); then
    usage
    exit 0
  fi

  local action=$1
  shift

  case "$action" in
    link)
      while (( $# > 0 )); do
        case "$1" in
          --target)
            TARGET_DIR=$2
            shift 2
            ;;
          *)
            die "Opción desconocida para link: $1"
            ;;
        esac
      done
      cmd_link
      ;;
    unlink)
      while (( $# > 0 )); do
        case "$1" in
          --target)
            TARGET_DIR=$2
            shift 2
            ;;
          *)
            die "Opción desconocida para unlink: $1"
            ;;
        esac
      done
      cmd_unlink
      ;;
    add)
      cmd_add "$@"
      ;;
    doctor)
      while (( $# > 0 )); do
        case "$1" in
          --target)
            TARGET_DIR=$2
            shift 2
            ;;
          *)
            die "Opción desconocida para doctor: $1"
            ;;
        esac
      done
      cmd_doctor
      ;;
    list)
      cmd_list
      ;;
    update-readme)
      cmd_update_readme
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      die "Comando desconocido: $action. Use $PROGRAM_NAME help."
      ;;
  esac
}

main "$@"
